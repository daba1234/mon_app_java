<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="14.0" style="-fx-background-color: white; -fx-padding: 18;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.microgest.controller.AdherentListController">
   <children>
      <Label text="Gestion des adhérents">
         <font>
            <Font size="22.0" />
         </font>
      </Label>
      <HBox spacing="10.0">
         <children>
            <TextField fx:id="searchField" promptText="Recherche nom, prénom ou téléphone" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="statutFilterComboBox" prefWidth="160.0" promptText="Statut" />
            <Button mnemonicParsing="false" onAction="#onApplyFiltersClick" text="Appliquer filtres" />
            <Button mnemonicParsing="false" onAction="#onResetFiltersClick" text="Réinitialiser" />
         </children>
      </HBox>
      <HBox spacing="10.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAddClick" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="Ajouter" />
            <Button mnemonicParsing="false" onAction="#onEditClick" text="Modifier" />
            <Button mnemonicParsing="false" onAction="#onDeleteClick" style="-fx-background-color: #b71c1c; -fx-text-fill: white;" text="Supprimer" />
         </children>
      </HBox>
      <TableView fx:id="adherentTable" prefHeight="420.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="80.0" text="ID" />
            <TableColumn fx:id="nomColumn" prefWidth="150.0" text="Nom" />
            <TableColumn fx:id="prenomColumn" prefWidth="150.0" text="Prénom" />
            <TableColumn fx:id="telephoneColumn" prefWidth="140.0" text="Tel" />
            <TableColumn fx:id="emailColumn" prefWidth="220.0" text="Email" />
            <TableColumn fx:id="statutColumn" prefWidth="120.0" text="Statut" />
         </columns>
      </TableView>
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Label text="Éléments / page" />
            <ComboBox fx:id="pageSizeComboBox" prefWidth="90.0" />
            <Button fx:id="firstButton" mnemonicParsing="false" onAction="#onFirstClick" text="Premier" />
            <Button fx:id="previousButton" mnemonicParsing="false" onAction="#onPreviousClick" text="Précédent" />
            <Label fx:id="pageInfoLabel" text="Page 1 / 1" />
            <Button fx:id="nextButton" mnemonicParsing="false" onAction="#onNextClick" text="Suivant" />
            <Button fx:id="lastButton" mnemonicParsing="false" onAction="#onLastClick" text="Dernier" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
   </padding>
</VBox>
